<style>
.about-layout {
  display: grid;
  grid-template-columns: 1fr 240px;
  gap: 0;
}

.about-body {
  padding-right: 40px;
}
.about-body p {
  font-size: 0.975rem;
  line-height: 1.85;
  color: var(--ct-muted);
  margin-bottom: 20px;
}
.about-body p:last-child {
  margin-bottom: 0;
}

.about-sidebar {
  padding-left: 32px;
  border-left: 2px solid var(--ct-border);
}

.skills-section {
  padding: 4px 0;
}

.skills-title {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ct-accent);
  margin-bottom: 12px;
}

.chips {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.chip {
  display: block;
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--ct-muted);
  line-height: 1.5;
}

.skills-divider {
  border: none;
  border-top: 1px solid var(--ct-border);
  margin: 20px 0;
}

@media (max-width: 760px) {
  .about-layout {
    grid-template-columns: 1fr;
  }
  .about-body {
    padding-right: 0;
    border-bottom: 2px solid var(--ct-border);
    padding-bottom: 28px;
    margin-bottom: 28px;
  }
  .about-sidebar {
    padding-left: 0;
    border-left: none;
  }
}
</style>
